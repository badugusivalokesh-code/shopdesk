# Copy this file to server/.env and replace the placeholders before starting
# the API. Never commit server/.env or real credentials.

# API listener port (1-65535).
PORT=5000

# MongoDB connection string used by Mongoose.
MONGODB_URI=replace-with-your-mongodb-connection-uri

# Use a random secret with at least 32 characters in local/production config.
JWT_SECRET=replace-with-at-least-32-random-characters

# One trusted browser origin. If omitted, validation defaults safely to this
# local development origin.
CLIENT_ORIGIN=http://localhost:5173

# Optional: override Node's DNS resolver for Atlas SRV and TXT discovery.
# Use only when the system resolver cannot serve those record types.
DNS_SERVERS=8.8.8.8,8.8.4.4
